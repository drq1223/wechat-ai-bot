# ============================================
# 微信高情商AI智能体 - 环境配置
# 复制此文件为 .env 并填入你的配置
# ============================================

# --- AIHubMix API (GLM-4.7 Free) ---
# 从 https://aihubmix.com 控制台的「API 密钥」页面获取
AIHUBMIX_API_KEY=your_api_key_here
AIHUBMIX_BASE_URL=https://aihubmix.com/v1
AIHUBMIX_MODEL=coding-glm-4.7-free

# --- 微信公众号 ---
# 测试号申请: https://mp.weixin.qq.com/debug/cgi-bin/sandbox?t=sandbox/login
WECHAT_APPID=your_appid_here
WECHAT_SECRET=your_secret_here
# 自己起一个字符串，要和公众号后台「服务器配置」里填的 Token 完全一致
WECHAT_TOKEN=my_wechat_token_2026

# --- 本地服务 ---
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# --- 机器人行为 ---
# 每用户最大对话记忆轮数
MAX_HISTORY_LENGTH=20
# 模拟人类回复延迟 (秒)
REPLY_DELAY_MIN=1
REPLY_DELAY_MAX=3
# 频率限制: 同一人两次回复最小间隔 (秒)
# 免费版限流 5 次/分钟，故间隔至少 12 秒；用付费模型可改回 2
RATE_LIMIT_COOLDOWN=13

# --- 联系人控制 ---
# 启用自动回复的联系人 (逗号分隔, 留空=全部启用)
ENABLED_CONTACTS=
# 禁用自动回复的联系人 (逗号分隔)
DISABLED_CONTACTS=
# 管理员联系人 (接收通知, 可用命令控制)
ADMIN_CONTACT=
# 是否处理群消息 (true/false)
ENABLE_GROUP_MESSAGE=false
